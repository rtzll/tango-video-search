{
	"name": "tango-video-search",
	"private": true,
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "https://github.com/rtzll/tango-video-search.git"
	},
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "vite build",
		"db:update": "node scripts/update-cloudflare-db.ts",
		"deploy": "vite build && wrangler deploy",
		"dev": "vite dev",
		"preview": "vite build && vite preview",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write .",
		"check": "oxlint . && vitest run && remix test && tsc && knip && vite build",
		"typecheck": "tsc",
		"knip": "knip",
		"test": "vitest run",
		"test:remix": "remix test",
		"test:watch": "vitest",
		"types": "wrangler types --include-runtime=false"
	},
	"dependencies": {
		"drizzle-orm": "^0.40.1",
		"remix": "3.0.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.62.5",
		"@cloudflare/vitest-pool-workers": "^0.18.8",
		"@cloudflare/workers-types": "^5.20261002.1",
		"@types/node": "^24.19.1",
		"knip": "^5.88.1",
		"oxfmt": "^0.46.0",
		"oxlint": "^1.86.0",
		"playwright": "1.60.0",
		"typescript": "^6.0.3",
		"vite": "^7.3.6",
		"vite-plus": "^0.2.9",
		"vitest": "4.1.10",
		"wrangler": "^4.147.0"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "pnpm@12.6.0",
	"knip": {
		"entry": [
			"app/assets/entry.ts",
			"app/**/*.test.{ts,tsx}",
			"app/**/*.test.browser.{ts,tsx}"
		],
		"ignoreDependencies": [
			"cloudflare"
		]
	}
}
