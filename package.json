{
	"name": "tango-video-search",
	"private": true,
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "https://github.com/rtzll/tango-video-search.git"
	},
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "react-router build",
		"db:update": "node scripts/update-cloudflare-db.ts",
		"deploy": "react-router build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "react-router build && wrangler dev --local --config build/server/wrangler.json --persist-to .wrangler/state",
		"lint": "vp lint .",
		"lint:fix": "vp lint --fix .",
		"format": "vp fmt --write .",
		"check": "vp lint . && vp test run && react-router typegen && tsc && knip && react-router build",
		"typecheck": "react-router typegen && tsc",
		"knip": "knip",
		"test": "vp test run",
		"test:watch": "vp test"
	},
	"dependencies": {
		"@radix-ui/react-icons": "^1.3.2",
		"@tailwindcss/vite": "^4.3.3",
		"drizzle-orm": "^0.45.4",
		"isbot": "^5.2.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.65.0",
		"@cloudflare/vitest-plugin": "^1.4.7",
		"@cloudflare/workers-types": "^5.20261024.1",
		"@react-router/dev": "^8.5.1",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"knip": "^6.43.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.152.0"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "pnpm@12.11.2",
	"knip": {
		"ignoreBinaries": [
			"sqlite3"
		],
		"ignoreDependencies": [
			"cloudflare"
		]
	}
}
