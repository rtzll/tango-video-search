{
	"name": "tango-video-search",
	"private": true,
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "https://github.com/rtzll/tango-video-search.git"
	},
	"workspaces": {
		"catalog": {
			"vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
			"vitest": "5.1.0",
			"vite-plus": "1.7.0"
		}
	},
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "react-router build",
		"db:update": "node scripts/update-cloudflare-db.ts",
		"deploy": "react-router build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "react-router build && wrangler dev --local --config build/server/wrangler.json --persist-to .wrangler/state",
		"lint": "vp lint -c .oxlintrc.json .",
		"lint:fix": "vp lint -c .oxlintrc.json --fix .",
		"format": "vp fmt -c .oxfmtrc.json --write .",
		"format:check": "vp fmt -c .oxfmtrc.json --check .",
		"check": "vp run format:check && vp run lint && vp test run && react-router typegen && tsc && knip && react-router build",
		"typecheck": "react-router typegen && tsc",
		"knip": "knip",
		"test": "vp test run",
		"test:watch": "vp test"
	},
	"dependencies": {
		"@radix-ui/react-icons": "^1.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"drizzle-orm": "^0.45.4",
		"isbot": "^5.2.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.70.1",
		"@cloudflare/vitest-plugin": "^1.9.0",
		"@cloudflare/workers-types": "^5.20261121.1",
		"@react-router/dev": "^8.5.2",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"knip": "^6.47.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.166.0"
	},
	"overrides": {
		"vite@*": "catalog:",
		"vitest@*": "catalog:"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "pnpm@12.11.2",
	"knip": {
		"ignoreBinaries": [
			"sqlite3"
		],
		"ignoreDependencies": [
			"cloudflare"
		]
	}
}
