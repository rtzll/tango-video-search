{
	"name": "tango-video-search",
	"private": true,
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "https://github.com/rtzll/tango-video-search.git"
	},
	"workspaces": {
		"catalog": {
			"vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
			"vitest": "5.1.0",
			"vite-plus": "1.7.0"
		}
	},
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "vp build",
		"build:analyze": "vp build --mode analyze",
		"db:update": "node scripts/update-cloudflare-db.ts",
		"deploy": "vp build && wrangler deploy",
		"dev": "vp dev",
		"preview": "vp build && wrangler dev --local --config build/server/wrangler.json --persist-to .wrangler/state",
		"lint": "vp lint -c .oxlintrc.json .",
		"lint:fix": "vp lint -c .oxlintrc.json --fix .",
		"format": "vp fmt -c .oxfmtrc.json --write .",
		"format:check": "vp fmt -c .oxfmtrc.json --check .",
		"check": "vp run format:check && vp run lint && vp test run && tsc && knip && vp build",
		"typecheck": "tsc",
		"knip": "knip",
		"test": "vp test run",
		"test:watch": "vp test"
	},
	"dependencies": {
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@7bff56b",
		"@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@7bff56b",
		"@tailwindcss/vite": "^4.3.5",
		"drizzle-orm": "^0.45.4",
		"effect": "4.1.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.70.2",
		"@cloudflare/vitest-plugin": "^1.9.2",
		"@cloudflare/workers-types": "^5.20261125.1",
		"@types/node": "^24.19.4",
		"knip": "^6.48.0",
		"rollup-plugin-visualizer": "7.1.3",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.168.0"
	},
	"overrides": {
		"vite@*": "catalog:",
		"vitest@*": "catalog:"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "pnpm@12.11.2",
	"knip": {
		"entry": [
			"app/tailwind.css"
		],
		"ignoreBinaries": [
			"sqlite3"
		]
	}
}
